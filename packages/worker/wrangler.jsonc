{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "petrol-baby-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"keep_vars": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {}
	},
	// The Cloudflare API rejects any `limits` block on the Free plan (error
	// 100328), and subrequests cannot be raised above the Free-plan cap there
	// anyway. Restore this (e.g. `{ "subrequests": 1000 }`, within the plan
	// maximum) once on a paid plan.
	// "limits": {
	// 	"subrequests": 10000
	// },
	"triggers": {
		"crons": ["* * * * *"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "PETROL_BABY_OBJECT",
				"class_name": "PetrolBabyObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PetrolBabyObject"]
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": ["**/prompts/*.md"],
			"fallthrough": true
		},
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	]
}
