# ── Database ─────────────────────────────────────────────────────────
# Absolute path to the SQLite database file. The directory must exist
# and be writable by the service user. Never use a relative path in
# production — a new working directory would silently create a fresh,
# empty database.
DATABASE_PATH=/var/lib/petrol-baby/petrol-baby.sqlite

# ── Fuel Finder API credentials ──────────────────────────────────────
FUEL_FINDER_CLIENT_ID=your-client-id
FUEL_FINDER_CLIENT_SECRET=your-client-secret

# ── API endpoint override (optional) ─────────────────────────────────
# Only needed for testing against the staging API or a mock server.
# Leave unset in production to use the real Fuel Finder API. Note that
# the API blocks non-UK IPs, so the host running this service should be
# in the UK.
#   FUEL_FINDER_BASE_URL=https://stg.fuel-finder.ics.gov.uk/api
FUEL_FINDER_BASE_URL=

# ── OpenRouter (used for LLM station-name cleaning) ──────────────────
# Required for the initial `bun run data:backfill` and for cleaning
# stations whose upstream data changes. The initial backfill will use a
# bit over $10 of credit.
OPENROUTER_API_KEY=

# How many station-cleaning LLM batches may run concurrently.
# Higher is faster but burstier. Defaults to 3.
LLM_CONCURRENCY=3
