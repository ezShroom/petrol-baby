{
	"name": "@petrol-baby/web",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "NODE_ENV=development bun --bun vite dev",
		"fetch-font": "bun scripts/fetch-font.js",
		"build": "bun --bun vite build",
		"preview": "bun ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint ."
	},
	"dependencies": {
		"@petrol-baby/server": "workspace:*"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1029.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.6.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	}
}
